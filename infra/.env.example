# Copie para infra/.env e substitua os valores de exemplo. O .env é ignorado pelo Git.

# Portas no host
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
POSTGRES_HOST_PORT=5433

# Django
DJANGO_DEBUG=false
# Mínimo de 50 caracteres aleatórios quando DJANGO_DEBUG=false (ex.: python -c "import secrets;print(secrets.token_urlsafe(48))")
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_LOG_LEVEL=INFO

# Ambiente local em HTTP: em produção, use HTTPS e ative estes valores
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_DB_SSLMODE=disable

# PostgreSQL
POSTGRES_DB=shelf
POSTGRES_USER=shelf
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Integrações opcionais
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_CONTACT_EMAIL=
